ARG MOVIEPILOT_BASE_IMAGE=jxxghp/moviepilot-v3:latest
FROM ${MOVIEPILOT_BASE_IMAGE}

ARG VCS_REF=local

USER root
WORKDIR /app

# 基础镜像须使用相同的 V3 运行时；本地源码和控制脚本作为同一版本覆盖。
COPY . /app
RUN find /app/app/application/site -maxdepth 1 -type f \
        \( -name 'sites.*.so' -o -name 'sites.*.pyd' -o -name 'sites.*.dylib' -o -name 'user.sites*.bin' \) -delete \
    && cp -f /app/docker/nginx.common.conf /etc/nginx/common.template.conf \
    && cp -f /app/docker/nginx.template.conf /etc/nginx/nginx.template.conf \
    && cp -f /app/docker/supervisord.conf /etc/supervisor/supervisord.conf \
    && cp -f /app/docker/launcher.sh /entrypoint.sh \
    && find /app/docker -maxdepth 1 -type f -name '*.sh' ! -name 'launcher.sh' \
        -exec cp -f -t /usr/local/lib/moviepilot/control {} + \
    && chmod 755 /entrypoint.sh \
    && chmod 500 /usr/local/lib/moviepilot/control/*.sh

LABEL org.opencontainers.image.revision="${VCS_REF}"
